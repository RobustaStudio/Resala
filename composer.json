{
    "name": "robust-tools/resala",
    "version": "3.0.0",
    "description": "Laravel SMS Gateway Integration Package",
    "keywords": [
        "robust-tools",
        "sms",
        "resala"
    ],
    "homepage": "https://github.com/RobustaStudio/Resala",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Mohamed AbdElaziz",
            "email": "mohabdelaziz95@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "guzzlehttp/guzzle": "^7.15.2",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "psr/http-message": "^1.1|^2.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.5|^13.0"
    },
    "autoload": {
        "psr-4": {
            "RobustTools\\Resala\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RobustTools\\Resala\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "RobustTools\\Resala\\SMSServiceProvider"
            ],
            "aliases": {
                "SMS": "RobustTools\\Resala\\Facades\\SMS"
            }
        }
    }
}
